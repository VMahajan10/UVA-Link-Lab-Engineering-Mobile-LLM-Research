<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a"
    android:padding="32dp">

    <!-- Main Timer Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Benchmark Running"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="48dp" />

        <!-- Time Remaining (Large Display) -->
        <TextView
            android:id="@+id/tvTimeRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="72sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:fontFamily="monospace"
            android:layout_marginBottom="32dp" />

        <!-- Time Remaining Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Remaining"
            android:textSize="18sp"
            android:textColor="#cccccc"
            android:layout_marginBottom="48dp" />

        <!-- Progress Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/tvQueriesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Queries: 0 / 0"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvBatteryInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery: --%"
                android:textSize="18sp"
                android:textColor="#cccccc"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDrainRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drain Rate: --%/h"
                android:textSize="16sp"
                android:textColor="#999999"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textColor="#4CAF50"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Stop Button (Bottom) -->
    <Button
        android:id="@+id/btnStopBenchmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Stop Benchmark"
        android:textSize="18sp"
        android:minHeight="56dp"
        android:backgroundTint="#f44336"
        android:textColor="#ffffff"
        android:layout_marginTop="16dp" />

</RelativeLayout>

